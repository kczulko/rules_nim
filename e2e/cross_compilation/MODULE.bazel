RULES_NIX_PKGS_VERSION = "0.14.1"

bazel_dep(name = "rules_nim", version = "0.0.0", dev_dependency = True)
bazel_dep(name = "platforms", version = "1.1.0", dev_dependency = True)
bazel_dep(name = "bazel_skylib", version = "1.9.2", dev_dependency = True)

bazel_dep(name = "bazel_lib", version = "3.7.2")
bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "rules_nixpkgs_cc")
bazel_dep(name = "rules_nixpkgs_core", version = RULES_NIX_PKGS_VERSION)
archive_override(
    module_name = "rules_nixpkgs_core",
    integrity = "sha256-VAJWiTZyBbg1GYZ35obYIItXC/2E5ocmhK5ld0dnO5c=",
    strip_prefix = "rules_nixpkgs-{}/core".format(RULES_NIX_PKGS_VERSION),
    urls = [
        "https://github.com/tweag/rules_nixpkgs/releases/download/v{version}/rules_nixpkgs-{version}.tar.gz".format(version = RULES_NIX_PKGS_VERSION),
    ],
)

archive_override(
    module_name = "rules_nixpkgs_cc",
    integrity = "sha256-VAJWiTZyBbg1GYZ35obYIItXC/2E5ocmhK5ld0dnO5c=",
    strip_prefix = "rules_nixpkgs-{}/toolchains/cc".format(RULES_NIX_PKGS_VERSION),
    urls = [
        "https://github.com/tweag/rules_nixpkgs/releases/download/v{version}/rules_nixpkgs-{version}.tar.gz".format(version = RULES_NIX_PKGS_VERSION),
    ],
)

local_path_override(
    module_name = "rules_nim",
    path = "../..",
)

nim = use_extension("@rules_nim//nim:extensions.bzl", "nim")
nim.toolchain(nim_version = "2.2.10")
use_repo(nim, "nim_toolchains")

register_toolchains("@nim_toolchains//:all")

nix_repo = use_extension("@rules_nixpkgs_core//extensions:repository.bzl", "nix_repo")
nix_repo.file(
    name = "nixpkgs",
    file = "//:nixpkgs.nix",
    file_deps = ["//:flake.lock"],
)
use_repo(nix_repo, "nixpkgs")

nix_pkg = use_extension("@rules_nixpkgs_core//extensions:package.bzl", "nix_pkg")
nix_pkg.attr(
    name = "file",
    attr = "file",
    repo = "@nixpkgs",
)
use_repo(nix_pkg, "file")

non_module_deps = use_extension("//toolchains:defs.bzl", "non_module_deps")
use_repo(
    non_module_deps,
    "gcc_14_aarch64_linux",
    "gcc_14_aarch64_linux_info",
    "gcc_14_aarch64_linux_toolchains",
)

register_toolchains(
    "@gcc_14_aarch64_linux_toolchains//:all",
)
